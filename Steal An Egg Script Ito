local function getStartingIndex()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return 1 end
    
    local playerPos = character.HumanoidRootPart.Position
    local closestIndex = 1
    local minDistance = math.huge
    
    for i, coord in ipairs(coordinates) do
        local distance = (playerPos - coord).Magnitude
        if distance < minDistance then
            minDistance = distance
            closestIndex = i
        end
    end
    
    return math.min(closestIndex + 1, #coordinates)
end

local function startChainTeleport()
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local startIndex = getStartingIndex()
    
    for i = startIndex, #coordinates do
        local targetPos = coordinates[i]
        character.HumanoidRootPart.CFrame = CFrame.new(targetPos)
        
        task.wait(0.002) 
    end
    
    print("2ms Chain Teleport Complete! Nakarating na sa huling coordinate.")
end

